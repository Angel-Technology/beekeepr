EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_GRAPHQL_URL=http://127.0.0.1:5158/graphql/
EXPO_PUBLIC_AUTH_BASE_URL=http://127.0.0.1:5158
EXPO_PUBLIC_AUTH_SCHEME=buzzkeepr
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=your-revenuecat-ios-public-sdk-key
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=your-revenuecat-android-public-sdk-key
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=Buzzkeepr Pro
EXPO_PUBLIC_TERMS_OF_USE_URL=https://buzzkeepr.com/terms-of-service
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://buzzkeepr.com/privacy-policy
EXPO_PUBLIC_SUPPORT_URL=https://buzzkeepr.com/support
EXPO_PUBLIC_PARTNERSHIPS_URL=https://buzzkeepr.com/partnerships
EXPO_PUBLIC_PERSONA_TEMPLATE_ID=your-persona-template-id
EXPO_PUBLIC_PERSONA_ENVIRONMENT=sandbox
EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn
# Set to '1' to exercise Sentry capture against the dashboard in __DEV__.
# Leave unset in normal dev — your local errors will pollute prod issues.
EXPO_PUBLIC_SENTRY_ENABLE_IN_DEV=
