# fastlane/Fastfile
# Buzzkeepr - Single app (App Store only)

require "base64"
require "fileutils"
require "json"

opt_out_usage
default_platform(:ios)

APP_NAME = "Buzzkeepr"

SCHEME    = ENV["IOS_SCHEME"] || "Buzzkeepr"
WORKSPACE = ENV["IOS_WORKSPACE"] || "ios/#{SCHEME}.xcworkspace"

BUILD_DIR   = File.expand_path("../build", __dir__) # <repo>/build
IOS_IPA     = File.join(BUILD_DIR, "#{APP_NAME}.ipa")
ANDROID_AAB = File.join(BUILD_DIR, "#{APP_NAME}.aab")
ANDROID_APK = File.join(BUILD_DIR, "#{APP_NAME}.apk")

# ---------------------------------------
# Helpers
# ---------------------------------------

def project_root
  File.expand_path("..", __dir__)
end

def ensure_build_dir!
  FileUtils.mkdir_p(File.expand_path(BUILD_DIR, __dir__))
end

def copy_build_artifact!(glob_pattern, destination)
  matches = Dir[File.join(project_root, glob_pattern)]
  UI.user_error!("No build artifact found for #{glob_pattern}") if matches.empty?

  FileUtils.cp(matches.first, destination)
end

def expo_prebuild(platform)
  # --no-install avoids expo trying to install deps/pods itself in CI
  sh("cd #{project_root} && npx expo prebuild --platform #{platform} --clean --no-install")
end

def ensure_ios_bundle_id!
  bundle_id = ENV["IOS_BUNDLE_ID"].to_s.strip
  UI.user_error!("Missing IOS_BUNDLE_ID") if bundle_id.empty?
  bundle_id
end

def ensure_ios_team_id!
  team_id = ENV["IOS_TEAM_ID"].to_s.strip
  UI.user_error!("Missing IOS_TEAM_ID") if team_id.empty?
  team_id
end

def write_asc_api_key_file!
  UI.user_error!("Missing ASC_KEY_ID") if ENV["ASC_KEY_ID"].to_s.strip.empty?
  UI.user_error!("Missing ASC_ISSUER_ID") if ENV["ASC_ISSUER_ID"].to_s.strip.empty?

  key_content = ENV["ASC_KEY_P8"]
  UI.user_error!("Missing ASC_KEY_P8") if key_content.to_s.strip.empty?

  decoded = ENV["ASC_KEY_P8_BASE64"] == "true" ? Base64.decode64(key_content) : key_content
  tmp_dir = File.join(__dir__, ".tmp")
  FileUtils.mkdir_p(tmp_dir)
  key_path = File.expand_path(File.join(tmp_dir, "asc_api_key.p8"))
  File.write(key_path, decoded)
  File.chmod(0o600, key_path)
  key_path
end

def setup_asc_api_key!
  key_path = write_asc_api_key_file!
  api_key = app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: key_path
  )
  # fastlane's return hash sometimes omits :key_filepath even when one was
  # passed in; xcodebuild's automatic signing needs the path explicitly,
  # so stash it on the result so callers don't have to re-derive it.
  api_key[:key_filepath] ||= key_path
  api_key
end

def resolve_play_json_key_path!
  return ENV["PLAY_JSON_KEY_PATH"] if ENV["PLAY_JSON_KEY_PATH"].to_s.strip.length > 0

  json_data = ENV["PLAY_JSON_KEY_DATA"].to_s
  UI.user_error!("Missing PLAY_JSON_KEY_DATA") if json_data.strip.length == 0

  tmp_dir = File.join(__dir__, ".tmp")
  FileUtils.mkdir_p(tmp_dir)

  path = File.expand_path(File.join(tmp_dir, "play-service-account.json"))
  File.write(path, json_data)
  path
end

def ensure_android_package_name!
  package_name = ENV["ANDROID_PACKAGE_NAME"].to_s.strip
  package_name = "com.buzzkeepr.app" if package_name.empty?
  package_name
end

def resolve_google_services_path!
  path = File.join(project_root, "google-services.json")
  UI.user_error!("Missing #{path}") unless File.exist?(path)
  path
end

def resolve_firebase_app_id!
  app_id = ENV["FIREBASE_APP_ID"].to_s.strip
  return app_id unless app_id.empty?

  google_services = JSON.parse(File.read(resolve_google_services_path!))
  clients = google_services.fetch("client", [])
  client = clients.find do |entry|
    entry.dig("client_info", "android_client_info", "package_name") == ensure_android_package_name!
  end
  UI.user_error!("Unable to find Firebase app id for package #{ensure_android_package_name!} in google-services.json") unless client

  client.fetch("client_info").fetch("mobilesdk_app_id")
end

def resolve_firebase_credentials_path!
  return ENV["FIREBASE_CREDENTIALS_PATH"] if ENV["FIREBASE_CREDENTIALS_PATH"].to_s.strip.length > 0

  json_data = ENV["FIREBASE_CREDENTIALS_JSON"].to_s
  UI.user_error!("Missing FIREBASE_CREDENTIALS_PATH or FIREBASE_CREDENTIALS_JSON") if json_data.strip.empty?

  tmp_dir = File.join(__dir__, ".tmp")
  FileUtils.mkdir_p(tmp_dir)

  path = File.expand_path(File.join(tmp_dir, "firebase-service-account.json"))
  File.write(path, json_data)
  path
end

def resolve_android_keystore_path!
  return ENV["ANDROID_KEYSTORE_PATH"] if ENV["ANDROID_KEYSTORE_PATH"].to_s.strip.length > 0

  keystore_data = ENV["ANDROID_KEYSTORE_BASE64"].to_s.strip
  UI.user_error!("Missing ANDROID_KEYSTORE_PATH or ANDROID_KEYSTORE_BASE64") if keystore_data.empty?

  tmp_dir = File.join(__dir__, ".tmp")
  FileUtils.mkdir_p(tmp_dir)

  keystore_path = File.expand_path(File.join(tmp_dir, "android-release.keystore"))
  File.binwrite(keystore_path, Base64.decode64(keystore_data))
  keystore_path
end

def ensure_android_signing_env!
  UI.user_error!("Missing ANDROID_KEY_ALIAS") if ENV["ANDROID_KEY_ALIAS"].to_s.strip.empty?
  UI.user_error!("Missing ANDROID_KEY_PASSWORD") if ENV["ANDROID_KEY_PASSWORD"].to_s.strip.empty?
  UI.user_error!("Missing ANDROID_KEYSTORE_PASSWORD") if ENV["ANDROID_KEYSTORE_PASSWORD"].to_s.strip.empty?
end

RELEASE_NOTES_MAX_CHARS = 3500

def truncated_release_notes
  notes = ENV["RELEASE_NOTES"].to_s
  return nil if notes.empty?
  return notes if notes.length <= RELEASE_NOTES_MAX_CHARS

  # TestFlight's changelog field caps around 4000 chars; supply has its own
  # limits. Trim well under to leave room for the truncation marker.
  notes[0, RELEASE_NOTES_MAX_CHARS - 12].rstrip + "\n…(truncated)"
end

# ==========================================
# Cross-platform housekeeping
# ==========================================

desc "Wipe local build outputs and Fastlane scratch directory"
lane :clean do
  paths = [
    File.expand_path(BUILD_DIR, __dir__),
    File.expand_path(File.join(__dir__, ".tmp")),
    File.expand_path(File.join(__dir__, "buildlog")),
  ]
  paths.each do |path|
    if Dir.exist?(path)
      FileUtils.rm_rf(path)
      UI.message("Removed #{path}")
    end
  end
  UI.success("Clean complete")
end

# ==========================================
# iOS
# ==========================================

platform :ios do
  desc "Build signed IPA for TestFlight / App Store using automatic signing"
  lane :build do
    ensure_build_dir!

    bundle_id = ensure_ios_bundle_id!
    team_id   = ensure_ios_team_id!

    UI.message("Building iOS (#{APP_NAME})")

    # Generate ios folder.
    expo_prebuild("ios")

    # Create the temp CI keychain that codesign will reach into.
    setup_ci

    # Import the Apple Distribution cert from a base64-encoded .p12 stored as
    # a CI secret. Without this in the keychain, codesign fails to find a
    # signing identity even though Xcode + ASC API can fetch profiles.
    cert_b64 = ENV["IOS_DISTRIBUTION_CERT_P12_BASE64"].to_s
    UI.user_error!(
      "Missing IOS_DISTRIBUTION_CERT_P12_BASE64. Export your team's Apple " \
      "Distribution certificate from Keychain Access as a .p12, base64-encode " \
      "it, and store the result as a CI secret."
    ) if cert_b64.strip.empty?

    cert_password = ENV["IOS_DISTRIBUTION_CERT_PASSWORD"].to_s
    UI.user_error!("Missing IOS_DISTRIBUTION_CERT_PASSWORD") if cert_password.empty?

    cert_path = File.expand_path(File.join(__dir__, ".tmp", "ios_distribution.p12"))
    FileUtils.mkdir_p(File.dirname(cert_path))
    File.binwrite(cert_path, Base64.decode64(cert_b64))

    import_certificate(
      certificate_path: cert_path,
      certificate_password: cert_password,
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: ""
    )

    # Set the development team in the xcodeproj so automatic signing knows
    # which team to provision profiles under.
    update_project_team(
      path: "ios/#{APP_NAME}.xcodeproj",
      teamid: team_id
    )

    cocoapods(
      podfile: "ios/Podfile",
      use_bundle_exec: true,
      repo_update: false,
      verbose: true
    )

    # Authenticate fastlane (and gym → xcodebuild) with App Store Connect so
    # automatic signing can fetch / create provisioning profiles via the API.
    api_key = setup_asc_api_key!

    update_code_signing_settings(
      use_automatic_signing: true,
      path: "ios/#{APP_NAME}.xcodeproj",
      team_id: team_id,
      bundle_identifier: bundle_id
    )

    # Use the workflow-provided build number so CI controls monotonic versioning.
    build_num = (ENV["IOS_BUILD_NUMBER"] || ENV["GITHUB_RUN_NUMBER"] || "1").to_i
    increment_build_number(
      xcodeproj: "ios/#{APP_NAME}.xcodeproj",
      build_number: build_num
    )
    UI.message("Using iOS build number: #{build_num}")

    # `-allowProvisioningUpdates` lets xcodebuild create / refresh the App
    # Store provisioning profile via ASC API on demand. The auth flags hand
    # xcodebuild the same ASC key fastlane already loaded so it can register
    # devices / cert mappings without prompting.
    asc_xcargs = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath '#{api_key[:key_filepath]}'",
      "-authenticationKeyID #{api_key[:key_id]}",
      "-authenticationKeyIssuerID #{api_key[:issuer_id]}"
    ].join(" ")

    gym(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      export_team_id: team_id,
      xcargs: asc_xcargs,

      # raw xcodebuild output (no xcpretty). Old flag is deprecated.
      xcodebuild_formatter: "",
      silent: false,
      buildlog_path: File.join(project_root, "fastlane", "buildlog"),

      export_options: {
        method: "app-store",
        signingStyle: "automatic",
        teamID: team_id
      },
      output_directory: BUILD_DIR,
      output_name: "#{APP_NAME}.ipa"
    )

    UI.success("IPA built at #{IOS_IPA}")
  end

  desc "Upload to TestFlight"
  lane :upload_testflight do |options|
    ipa_path = options[:ipa] || IOS_IPA
    UI.user_error!("IPA not found at #{ipa_path}.") unless File.exist?(ipa_path)

    setup_asc_api_key!

    pilot(
      ipa: ipa_path,
      app_identifier: ensure_ios_bundle_id!,
      skip_waiting_for_build_processing: false,
      changelog: truncated_release_notes,
      distribute_external: false
    )
  end

  desc "Submit the latest TestFlight build to App Store review (with screenshots)"
  lane :submit_review do
    api_key = setup_asc_api_key!

    screenshots_dir = File.expand_path(File.join(__dir__, "screenshots"))
    has_screenshots = Dir.exist?(screenshots_dir) &&
      Dir.glob(File.join(screenshots_dir, "**", "*.{png,jpg,jpeg}")).any?

    if has_screenshots
      UI.message("Uploading screenshots from #{screenshots_dir}")
    else
      UI.important("No screenshots found in #{screenshots_dir}; submitting without updating screenshots.")
    end

    # `deliver` defaults to submitting whichever build is currently the latest
    # available on App Store Connect — i.e. whatever the dev workflow last
    # uploaded to TestFlight. No `ipa:` parameter; this lane never builds.
    deliver(
      api_key: api_key,
      app_identifier: ensure_ios_bundle_id!,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_metadata: true,
      skip_screenshots: !has_screenshots,
      overwrite_screenshots: has_screenshots,
      screenshots_path: screenshots_dir,
      precheck_include_in_app_purchases: false
    )
  end
end

# ==========================================
# Android
# ==========================================

platform :android do
  desc "Build Android AAB"
  lane :build do
    ensure_build_dir!
    ensure_android_signing_env!

    keystore_path = resolve_android_keystore_path!

    UI.message("Building Android (#{APP_NAME})")

    expo_prebuild("android")

    gradle(
      project_dir: "android",
      task: "bundleRelease",
      flags: "--stacktrace --warning-mode all",
      properties: {
        "ANDROID_KEYSTORE_PATH" => keystore_path,
        "ANDROID_KEYSTORE_PASSWORD" => ENV["ANDROID_KEYSTORE_PASSWORD"],
        "ANDROID_KEY_ALIAS" => ENV["ANDROID_KEY_ALIAS"],
        "ANDROID_KEY_PASSWORD" => ENV["ANDROID_KEY_PASSWORD"],
        "android.injected.signing.store.file" => keystore_path,
        "android.injected.signing.store.password" => ENV["ANDROID_KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["ANDROID_KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["ANDROID_KEY_PASSWORD"]
      }
    )

    copy_build_artifact!("android/app/build/outputs/bundle/release/*.aab", ANDROID_AAB)

    UI.success("AAB built at #{ANDROID_AAB}")
  end

  desc "Build Android APK for Firebase App Distribution"
  lane :build_apk do
    ensure_build_dir!
    ensure_android_signing_env!

    keystore_path = resolve_android_keystore_path!

    UI.message("Building Android APK (#{APP_NAME})")

    expo_prebuild("android")

    gradle(
      project_dir: "android",
      task: "assembleRelease",
      flags: "--stacktrace --warning-mode all",
      properties: {
        "ANDROID_KEYSTORE_PATH" => keystore_path,
        "ANDROID_KEYSTORE_PASSWORD" => ENV["ANDROID_KEYSTORE_PASSWORD"],
        "ANDROID_KEY_ALIAS" => ENV["ANDROID_KEY_ALIAS"],
        "ANDROID_KEY_PASSWORD" => ENV["ANDROID_KEY_PASSWORD"],
        "android.injected.signing.store.file" => keystore_path,
        "android.injected.signing.store.password" => ENV["ANDROID_KEYSTORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["ANDROID_KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["ANDROID_KEY_PASSWORD"]
      }
    )

    copy_build_artifact!("android/app/build/outputs/apk/release/*.apk", ANDROID_APK)

    UI.success("APK built at #{ANDROID_APK}")
  end

  desc "Upload to Google Play"
  lane :play do
    UI.user_error!("AAB not found. Run android build first.") unless File.exist?(ANDROID_AAB)

    package_name = ensure_android_package_name!
    track = (ENV["PLAY_TRACK"] || "internal").strip
    release_status = ENV["PLAY_RELEASE_STATUS"].to_s.strip
    release_status = (track == "internal" ? "completed" : "draft") if release_status.empty?

    supply(
      aab: ANDROID_AAB,
      package_name: package_name,
      track: track,
      json_key: resolve_play_json_key_path!,
      release_status: release_status,
      changelog: truncated_release_notes,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Distribute Android AAB to Firebase App Distribution testers"
  lane :firebase_distribution do
    artifact_type = (ENV["FIREBASE_ANDROID_ARTIFACT_TYPE"] || "APK").strip.upcase
    artifact_type = "APK" unless %w[APK AAB].include?(artifact_type)

    artifact_path =
      if artifact_type == "AAB"
        UI.user_error!("AAB not found. Run android build first.") unless File.exist?(ANDROID_AAB)
        ANDROID_AAB
      else
        UI.user_error!("APK not found. Run android build_apk first.") unless File.exist?(ANDROID_APK)
        ANDROID_APK
      end

    firebase_app_distribution(
      app: resolve_firebase_app_id!,
      android_artifact_type: artifact_type,
      android_artifact_path: artifact_path,
      service_credentials_file: resolve_firebase_credentials_path!,
      release_notes: truncated_release_notes,
      testers: ENV["FIREBASE_TESTERS"],
      groups: ENV["FIREBASE_GROUPS"]
    )
  end
end
