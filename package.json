{
  "name": "buzzkeepr",
  "packageManager": "yarn@3.2.4",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "codegen": "graphql-codegen --require dotenv/config --config codegen.yml",
    "build:check": "yarn type-check && npx expo prebuild --clean",
    "prebuild": "npx expo prebuild",
    "prebuild:clean": "npx expo prebuild --clean",
    "storybook": "cross-env EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start",
    "storybook:ios": "cross-env EXPO_PUBLIC_STORYBOOK_ENABLED=true expo run:ios",
    "storybook:android": "cross-env EXPO_PUBLIC_STORYBOOK_ENABLED=true expo run:android",
    "storybook-generate": "sb-rn-get-stories -c ./.rnstorybook"
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@better-auth/expo": "^1.5.5",
    "@gorhom/bottom-sheet": "^5.2.10",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-community/slider": "5.1.2",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/drawer": "^7.9.4",
    "@storybook/addon-ondevice-actions": "^10.3.2",
    "@storybook/addon-ondevice-controls": "^10.3.2",
    "@storybook/react-native": "^10.3.2",
    "@tanstack/react-query": "^5.90.2",
    "babel-loader": "^8.4.1",
    "better-auth": "^1.5.5",
    "clsx": "^2.1.1",
    "expo": "^55",
    "expo-blur": "~55.0.14",
    "expo-constants": "~55.0.13",
    "expo-image": "~55.0.8",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.12",
    "expo-network": "~55.0.13",
    "expo-router": "~55.0.12",
    "expo-secure-store": "~55.0.13",
    "expo-splash-screen": "~55.0.17",
    "expo-status-bar": "~55.0.5",
    "expo-system-ui": "~55.0.15",
    "expo-web-browser": "~55.0.14",
    "graphql": "^16.11.0",
    "graphql-request": "^7.3.4",
    "js-yaml": "^4.1.1",
    "lucide-react-native": "^1.6.0",
    "nativewind": "^4.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-persona": ">=2.7.0",
    "react-native-purchases": "^9.15.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "^15.15.3",
    "react-native-worklets": "0.7.2",
    "storybook": "^10.3.5"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.0.1",
    "@graphql-codegen/typed-document-node": "^6.0.1",
    "@graphql-codegen/typescript": "^5.0.5",
    "@graphql-codegen/typescript-operations": "^5.0.5",
    "@storybook/addon-ondevice-notes": "^10",
    "@types/jest": "29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "~19.2.10",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "^55",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jest": "~29.7.0",
    "jest-expo": "^55",
    "jest-junit": "^16.0.0",
    "prettier": "^3.8.0",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "react-test-renderer": "^19.2.3",
    "tailwindcss": "^3.4.17",
    "typescript": "latest"
  },
  "private": true,
  "author": "Samuel Wemimo",
  "license": "MIT"
}
